<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="projekt.LevelSelectController"
            prefWidth="1920" prefHeight="1080"
            style="-fx-background-color: #e6ffe6;">

    <Button fx:id="level1Button"
            layoutX="660" layoutY="400"
            prefWidth="180" prefHeight="240"
            text="I"
            onAction="#onLevel1">
        <font>
            <Font size="72"/>
        </font>
    </Button>

    <Button fx:id="level2Button"
            layoutX="870" layoutY="400"
            prefWidth="180" prefHeight="240"
            text="II"
            onAction="#onLevel2">
        <font>
            <Font size="72"/>
        </font>
    </Button>

    <Button fx:id="level3Button"
            layoutX="1080" layoutY="400"
            prefWidth="180" prefHeight="240"
            text="III"
            onAction="#onLevel3">
        <font>
            <Font size="72"/>
        </font>
    </Button>

    <Button
            fx:id="backButton"
            layoutX="40"
            layoutY="40"
            prefWidth="160"
            prefHeight="60"
            text="Back"
            onAction="#onBack">
    </Button>

</AnchorPane>
